<Window x:Class="ProjektReolmarked.View.AfregningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjektReolmarked.View"
        mc:Ignorable="d"
        Title="AfregningWindow" Height="450" Width="800">
    <Grid>
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: list of all reollejere -->
            <ListBox Grid.Column="0" Margin="0,0,10,0"
              ItemsSource="{Binding ReolLejere}"
              SelectedItem="{Binding ValgtReolLejer}" 
              SelectionMode="Single" />

            <!-- Right: text boxes, buttons and message -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="År"/>
                <TextBox Text="{Binding Aar}" Margin="0,0,0,10"/>

                <TextBlock Text="Måned"/>
                <TextBox Text="{Binding Maaned}" Margin="0,0,0,10"/>

                <TextBlock Text="Samlet salg"/>
                <TextBlock Foreground="DarkRed" Text="(Midlertidig løsning uden lejer salg)"/>
                <TextBox Text="{Binding SamletSalg}" Margin="0,0,0,20"/>


                <TextBlock Text="Antal reoler"/>
                <TextBlock Foreground="DarkRed" Text="(Midlertidig løsning uden reoler)"/>
                <TextBox Text="{Binding LejerReolAntal}" Margin="0,0,0,20" />

                <Button Content="Opret" Command="{Binding OpretCommand}" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding Besked}" TextWrapping="Wrap"/>
            </StackPanel>

            <DataGrid Grid.Column="2" Margin="10,0,10,0"
                ItemsSource="{Binding Afregninger}"
                IsReadOnly="True"/>
        </Grid>
    </Grid>
</Window>
