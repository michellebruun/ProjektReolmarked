<Window x:Class="ProjektReolmarked.View.ReolLejerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjektReolmarked.View"
        mc:Ignorable="d"
        Title="Reollejere"
        Height="600"
        Width="900"
        Background="#F5F5F7">

    <Window.Resources>

        <Style x:Key="MacButton" TargetType="Button">

            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D2D2D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">

                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="6"
                                    ShadowDepth="1"
                                    Opacity="0.07"/>
                            </Border.Effect>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#F0F0F2"/>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="#B8B8BD"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#E5E5E7"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>


        <Style x:Key="MacTextBox" TargetType="TextBox">

            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D2D2D7"/>
            <Setter Property="BorderThickness" Value="1"/>

        </Style>


        <Style TargetType="DataGrid">

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D2D2D7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E5E7"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D2D2D7"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFAFA"/>

        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="10"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- HEADER -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Text="Reollejere"
                FontSize="28"
                FontWeight="Bold"
                Foreground="#1D1D1F"/>

            <TextBlock
                Text="Opret, rediger og administrer reollejere"
                FontSize="14"
                Foreground="#6E6E73"
                Margin="0,2,0,0"/>

        </StackPanel>


        <!-- CONTENT -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="20"/>

                <ColumnDefinition Width="280"/>

            </Grid.ColumnDefinitions>


            <!-- REOLLEJERE LIST -->

            <Border
                Grid.Column="0"
                Background="#FFFFFF"
                CornerRadius="14"
                BorderBrush="#D2D2D7"
                BorderThickness="1"
                Padding="10">

                <Border.Effect>

                    <DropShadowEffect
                        BlurRadius="12"
                        ShadowDepth="2"
                        Opacity="0.08"/>

                </Border.Effect>


                <DataGrid
                        ItemsSource="{Binding ReolLejere}"
                        SelectedItem="{Binding ValgtReolLejer, Mode=TwoWay}"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        HeadersVisibility="Column">

                    <DataGrid.Columns>

                        <DataGridTextColumn
                            Header="ReolLejerID"
                            Binding="{Binding ReolLejerId}"
                            Width="100"/>

                        <DataGridTextColumn
                            Header="Navn"
                            Binding="{Binding Navn}"
                            Width="*"/>

                        <DataGridTextColumn
                            Header="Telefon"
                            Binding="{Binding Telefon}"
                            Width="130"/>

                        <DataGridTextColumn
                            Header="Email"
                            Binding="{Binding Email}"
                            Width="*"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>


            <!-- REOLLEJER FORM -->

            <Border
                Grid.Column="2"
                Background="#FFFFFF"
                CornerRadius="14"
                BorderBrush="#D2D2D7"
                BorderThickness="1"
                Padding="14">

                <Border.Effect>

                    <DropShadowEffect
                        BlurRadius="12"
                        ShadowDepth="2"
                        Opacity="0.08"/>

                </Border.Effect>


                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel>

                        <TextBlock
                            Text="ReolLejer"
                            FontSize="19"
                            FontWeight="SemiBold"
                            Foreground="#1D1D1F"
                            Margin="0,0,0,10"/>


                        <!-- NAVN -->

                        <TextBlock
                            Text="Navn"
                            FontSize="12"
                            Foreground="#6E6E73"
                            Margin="0,0,0,2"/>

                        <TextBox
                            Text="{Binding Navn, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MacTextBox}"
                            Margin="0,0,0,7"/>


                        <!-- TELEFON -->

                        <TextBlock
                            Text="Telefon"
                            FontSize="12"
                            Foreground="#6E6E73"
                            Margin="0,0,0,2"/>

                        <TextBox
                            Text="{Binding Telefon, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MacTextBox}"
                            Margin="0,0,0,7"/>


                        <!-- EMAIL -->

                        <TextBlock
                            Text="E-mail"
                            FontSize="12"
                            Foreground="#6E6E73"
                            Margin="0,0,0,2"/>

                        <TextBox
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MacTextBox}"
                            Margin="0,0,0,8"/>


                        <!-- BUTTONS -->

                        <Button
                            Content="Opret"
                            Command="{Binding OpretCommand}"
                            Style="{StaticResource MacButton}"/>

                        <Button
                            Content="Gem ændringer"
                            Command="{Binding GemCommand}"
                            Style="{StaticResource MacButton}"/>

                        <Button
                            Content="Slet"
                            Command="{Binding SletCommand}"
                            Style="{StaticResource MacButton}"
                            Margin="0,2,0,8"/>


                        <!-- MESSAGE -->

                        <Border
                            Margin="0,5,0,0"
                            Padding="8"
                            Background="#F5F5F7"
                            CornerRadius="6">

                            <TextBox
                                Text="{Binding Besked}"
                                TextWrapping="Wrap"
                                IsReadOnly="True"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#6E6E73"
                                FontSize="12"
                                Padding="0"
                                IsTabStop="False"/>
                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</Window>