<Window x:Class="ProjektReolmarked.View.ReolLejerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProjektReolmarked.View"
        mc:Ignorable="d"
        Title="Reollejere" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Left: list of all reollejere -->
        <DataGrid Grid.Column="0" Margin="0,0,10,0"
                  ItemsSource="{Binding ReolLejere}"
                  SelectedItem="{Binding ValgtReolLejer}"
                  IsReadOnly="True"/>

        <!-- Right: text boxes, buttons and message -->
        <StackPanel Grid.Column="1">
            <TextBlock Text="Navn"/>
            <TextBox Text="{Binding Navn}" Margin="0,0,0,10"/>

            <TextBlock Text="Telefon"/>
            <TextBox Text="{Binding Telefon}" Margin="0,0,0,10"/>

            <TextBlock Text="E-mail"/>
            <TextBox Text="{Binding Email}" Margin="0,0,0,20"/>

            <Button Content="Opret" Command="{Binding OpretCommand}" Margin="0,0,0,5"/>
            <Button Content="Gem ændringer" Command="{Binding GemCommand}" Margin="0,0,0,5"/>
            <Button Content="Slet" Command="{Binding SletCommand}" Margin="0,0,0,20"/>

            <TextBlock Text="{Binding Besked}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
